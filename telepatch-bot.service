# Telepatch bot as a systemd service.
#
#   sudo cp telepatch-bot.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now telepatch-bot
#   journalctl -u telepatch-bot -f
#
# Assumes the repo at /opt/telepatch, a venv at /opt/telepatch/.venv, and a
# .env alongside them, owned by root and mode 0600. Adjust paths and User
# to taste. See docs/runbook.md.

[Unit]
Description=Telepatch - Telegram to Telegraph publishing bridge
Documentation=https://github.com/babbworks/telepatch
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
NotifyAccess=main
User=telepatch
Group=telepatch
WorkingDirectory=/opt/telepatch
EnvironmentFile=/opt/telepatch/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/telepatch/.venv/bin/python /opt/telepatch/bot.py

# Long polling dials out to api.telegram.org. A dropped connection should
# reconnect rather than end the service.
Restart=always
RestartSec=5

# A bot that has stopped polling looks perfectly healthy to Restart=always,
# because the process is still there. The watchdog is what tells the
# difference: bot.py pings systemd on a timer, and silence is a restart.
WatchdogSec=180

# Give it a moment to finish an in-flight editPage rather than tearing it
# off mid-write. Telegraph has no transactions and no undo.
TimeoutStopSec=30
KillSignal=SIGINT

# The one thing the bot now writes: activity counters for
# telepatch-observer, at /run/telepatch/counters.json.
#
# This is tmpfs, and systemd DELETES it when the unit stops. That is the
# point rather than a side effect - it is what makes "no counter survives a
# restart" a property of the deployment instead of a promise in prose. See
# COUNTED in bot.py and the privacy section of
# docs/superpowers/specs/2026-08-01-observer-design.md.
#
# 0755 so a future unprivileged observer can read it. The file holds counts
# and nothing else; there is nothing in it to protect.
RuntimeDirectory=telepatch
RuntimeDirectoryMode=0755

# Beyond that the bot writes nothing and needs nothing, so give it nothing.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
UMask=0077

# One scan holds every page's content in memory at once, bounded by
# INDEX_LIMIT. These are ceilings, not budgets: hitting one is a bug.
MemoryMax=512M
TasksMax=64
CPUQuota=200%

[Install]
WantedBy=multi-user.target
