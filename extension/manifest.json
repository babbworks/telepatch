{
  "manifest_version": 3,
  "name": "Telepatch",
  "version": "0.1.0",
  "description": "Save the page you are on into a Telepatch collection.",

  "permissions": ["storage"],
  "host_permissions": ["https://api.telegra.ph/*"],

  "background": { "service_worker": "background.js" },

  "action": {
    "default_title": "Telepatch",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },

  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },

  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
