# Telepatch as a *user* service, for a machine you already log into.
#
#   mkdir -p ~/.config/systemd/user
#   cp telepatch-bot.user.service ~/.config/systemd/user/telepatch-bot.service
#   loginctl enable-linger "$USER"       # so it runs without you logged in
#   systemctl --user daemon-reload
#   systemctl --user enable --now telepatch-bot
#   journalctl --user -u telepatch-bot -f
#
# No root anywhere. Lingering is what makes it start at boot and survive
# logout; without it the service dies with your session.
#
# For a dedicated server use telepatch-bot.service instead, which runs as
# its own user with the full sandbox. See docs/server-setup.md.

[Unit]
Description=Telepatch - Telegram to Telegraph publishing bridge
Documentation=https://github.com/babbworks/telepatch
After=network-online.target

[Service]
Type=notify
NotifyAccess=main
WorkingDirectory=%h/making/telepatchbot/telepatch
EnvironmentFile=%h/making/telepatchbot/.env
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/making/telepatchbot/.venv/bin/python %h/making/telepatchbot/telepatch/bot.py

Restart=always
RestartSec=5

# A bot that has stopped polling looks perfectly healthy to Restart=always,
# because the process is still there. bot.py pings systemd on a timer and
# silence is what triggers the restart.
WatchdogSec=180

# Let an in-flight editPage finish rather than tearing it off mid-write.
# Telegraph has no transactions and no undo.
TimeoutStopSec=30
KillSignal=SIGINT

# Most of the sandbox works in a user unit. The parts that need root -
# a separate User=, ProtectHome - are in the system unit instead.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/making/telepatchbot
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
UMask=0077

# Ceilings, not budgets. Hitting one is a bug.
MemoryMax=512M
TasksMax=64

[Install]
WantedBy=default.target
