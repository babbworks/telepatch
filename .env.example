# Copy to .env and fill in. The real file is gitignored and must stay that
# way. On a server it belongs outside the repo, owned by root, mode 0600,
# and referenced from the unit's EnvironmentFile.

# From @BotFather. The only required setting; the bot refuses to start
# without one shaped like a token rather than failing on first use.
TELEGRAM_TOKEN=123456789:replace-me

# Where the website lives, so /site hands out working links. This is the
# one thing to change when the custom domain is decided.
# SITE_URL=https://babbworks.github.io/telepatch/

# --- optional. Unset on a laptop; set on a server. ---

# Numeric chat id that unhandled errors are reported to.
# OPERATOR_CHAT=

# A dead man's switch. Long polling opens no port, so nothing outside can
# check whether the bot is alive - it pings this instead, and silence is
# what raises the alarm. healthchecks.io, Better Stack, or your own.
# HEARTBEAT_URL=
# HEARTBEAT_SECONDS=300

# DEBUG, INFO, WARNING, ERROR. Credentials are stripped at every level.
# LOG_LEVEL=INFO

# Where the bot writes activity counters for telepatch-observer to read.
# tmpfs, created and destroyed by RuntimeDirectory= in the unit. Only worth
# setting if you moved it.
# COUNTERS_PATH=/run/telepatch/counters.json


# --- telepatch-observer. Only needed by that service. ---
#
# The bot ignores every setting below, and the observer ignores every
# setting above. They share one .env because they share one machine.

# Telegraph token for the operations account - a DIFFERENT account from any
# publishing account. Separate identity means that if it is ever throttled,
# no user is affected. The service exits at startup if this is missing or
# rejected, rather than failing quietly half an hour later.
# OBSERVER_TOKEN=

# The page it edits, forever. There is no createPage anywhere in the
# observer, so this being configuration rather than state is what makes a
# second page impossible however many times the service restarts.
# OBSERVER_PAGE_PATH=telepatch-server-performance-08-01

# The title to keep on that page. Telegraph's editPage replaces everything,
# including the title, so it has to be sent every time.
# OBSERVER_PAGE_TITLE=telepatch-server-performance

# Sample every two minutes, publish the mean every thirty. 48 edits a day.
# For scale: one /site rebuild can fire ~200 Telegraph calls in a burst, so
# a full day of observer traffic is a quarter of a single index rebuild.
# OBSERVER_SAMPLE_SECONDS=120
# OBSERVER_PUBLISH_SECONDS=1800

# How many completed hours the Activity section shows side by side, oldest
# first. Each column is still one whole completed hour, still suppressed
# below 5 - more columns is more of the same resolution, not a finer one.
# OBSERVER_ACTIVITY_HOURS=6

# The local copy. samples.log is written alongside it automatically and
# holds the raw two-minute readings - it is the more detailed artifact of
# the two, and stays on the machine.
# OBSERVER_LOG=/var/log/telepatch/observer.log

# The unit to report on.
# OBSERVER_UNIT=telepatch-bot.service

# OBSERVER_LOG_LEVEL=INFO
